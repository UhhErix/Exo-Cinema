<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Exo's identity (plan §2): the device keys in CNG (TPM first), the device list, linking a PC, the recovery code, the
    envelope, sync batches and the mailbox frames, shared by Exo Launcher, Exo Cinema and Exo Browser. No UI, no network
    of its own and no app's data folder: each app vendors this folder as it is and runs Vectors/exo-identity-vectors.json
    against it, so all three stay byte for byte the same.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Every app builds this with Native AOT: anything that needs reflection or code at run time stops the build. -->
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL3050</WarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Exo.Identity</AssemblyName>
    <RootNamespace>Exo.Identity</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ExoLauncher" />
    <InternalsVisibleTo Include="ExoLauncher.Tests" />
    <None Include="Vectors\exo-identity-vectors.json" />
  </ItemGroup>
</Project>
