<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The player's automatic choices on simulated PCs: the app's pure rule files are compiled in as they are (no window,
    no mpv), and each test feeds them made-up hardware. The running app stays the real check for what mpv does.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <Platforms>x64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- The film reader (Mpv/PlayStream.cs) is mpv's callbacks over raw buffers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>ExoCinema.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exo's identity, as the app has it: the shared vectors run against it byte for byte (IdentityVectorsTests). -->
    <ProjectReference Include="..\..\src\Exo.Identity\Exo.Identity.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="..\..\src\ExoCinema\AppInfo.cs" Link="App\AppInfo.cs" />
    <Compile Include="..\..\src\ExoCinema\Ui\CaptionDragRegions.cs" Link="App\CaptionDragRegions.cs" />
    <Compile Include="..\..\src\ExoCinema\Ui\HiddenWindow.cs" Link="App\HiddenWindow.cs" />
    <Compile Include="..\..\src\ExoCinema\Jellyfin\*.cs" LinkBase="App\Jellyfin" />
    <Compile Include="..\..\src\ExoCinema\Library\PlayerSurface.cs" Link="App\PlayerSurface.cs" />
    <Compile Include="..\..\src\ExoCinema\Library\CinemaLibrary.cs" Link="App\CinemaLibrary.cs" />
    <Compile Include="..\..\src\ExoCinema\Net\StreamProbe.cs" Link="App\StreamProbe.cs" />
    <Compile Include="..\..\src\ExoCinema\AppLog.cs" Link="App\AppLog.cs" />
    <Compile Include="..\..\src\ExoCinema\UiGuard.cs" Link="App\UiGuard.cs" />
    <Compile Include="..\..\src\ExoCinema\GraphicsCard.cs" Link="App\GraphicsCard.cs" />
    <Compile Include="..\..\src\ExoCinema\LinkFit.cs" Link="App\LinkFit.cs" />
    <Compile Include="..\..\src\ExoCinema\LinkSpeed.cs" Link="App\LinkSpeed.cs" />
    <Compile Include="..\..\src\ExoCinema\PlaybackPlan.cs" Link="App\PlaybackPlan.cs" />
    <Compile Include="..\..\src\ExoCinema\HdrFilms.cs" Link="App\HdrFilms.cs" />
    <Compile Include="..\..\src\ExoCinema\LegacyData.cs" Link="App\LegacyData.cs" />
    <Compile Include="..\..\src\ExoCinema\PictureRules.cs" Link="App\PictureRules.cs" />
    <Compile Include="..\..\src\ExoCinema\Mpv\WarmupPlan.cs" Link="App\WarmupPlan.cs" />
    <Compile Include="..\..\src\ExoCinema\SoundOutput.cs" Link="App\SoundOutput.cs" />
    <Compile Include="..\..\src\ExoCinema\Watch\WatchLedger.cs" Link="App\WatchLedger.cs" />
    <Compile Include="..\..\src\ExoCinema\Mpv\ScrubPlan.cs" Link="App\ScrubPlan.cs" />
    <Compile Include="..\..\src\ExoCinema\Mpv\StartBuffer.cs" Link="App\StartBuffer.cs" />
    <Compile Include="..\..\src\ExoCinema\Mpv\ReadAhead.cs" Link="App\ReadAhead.cs" />
    <Compile Include="..\..\src\ExoCinema\Mpv\SystemMemory.cs" Link="App\SystemMemory.cs" />
